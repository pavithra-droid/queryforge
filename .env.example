# Optional. Only needed when running Django/Celery outside Docker.
# Copy to .env and adjust. Defaults already match docker-compose.yml.

POSTGRES_DB=queryforge
POSTGRES_USER=queryforge
POSTGRES_PASSWORD=queryforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0

# offline (default, deterministic, no key) or ollama
LLM_PROVIDER=offline
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# Production must override these
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# API throttle for creating questions (per client IP)
QUESTION_CREATE_RATE=10/minute
